{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "rmd 主窗口的默认权限。⭐ 自有命令全给；core 插件只给 0010 明确要的那三条。",
  "windows": ["main"],
  "permissions": [
    "allow-get-session",
    "allow-take-pending-open",
    "allow-set-sidebar-width",
    "allow-set-sidebar-file-view",
    "allow-set-appearance",
    "allow-set-language",
    "allow-get-shortcuts",
    "allow-choose-directory",
    "allow-choose-file",
    "allow-close-directory",
    "allow-open-recent-directory",
    "allow-open-favorite",
    "allow-favorites-apply",
    "allow-recent-apply",
    "allow-list-dir",
    "allow-search-files",
    "allow-list-documents",
    "allow-create-entry",
    "allow-rename-entry",
    "allow-reveal-entry",
    "allow-reconcile-disk",
    "allow-retry-tree-watch",
    "allow-open-document",
    "allow-reload-document",
    "allow-watch-document",
    "allow-unwatch-document",
    "allow-open-in-external-editor",
    "allow-read-asset",
    "allow-begin-edit",
    "allow-end-edit",
    "allow-render-preview",
    "allow-save-document",
    "allow-set-reading-progress",
    "allow-set-dir-session",
    "allow-open-link",
    "allow-report-status",
    "allow-report-measure",
    "core:event:allow-listen",
    "core:event:allow-unlisten"
  ]
}
