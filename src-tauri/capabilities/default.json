{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "rmd 全部窗口的默认权限。⭐ 自有命令全给；core 插件只给 0010 明确要的那三条。⚠️ `design/0071` §5 起窗口不止一个：主窗口 `main` 与 `⌘N`、右键开出来的 `w-1`、`w-2`… 共用这一份（漏掉 `w-*` 的表现是「新窗口一片空白」——所有 IPC 都被 ACL 静默拒）。",
  "windows": ["main", "w-*"],
  "permissions": [
    "allow-get-session",
    "allow-take-pending-open",
    "allow-set-sidebar-width",
    "allow-set-sidebar-file-view",
    "allow-set-appearance",
    "allow-set-language",
    "allow-get-shortcuts",
    "allow-set-window-title",
    "allow-choose-directory",
    "allow-choose-file",
    "allow-close-directory",
    "allow-open-recent-directory",
    "allow-open-favorite",
    "allow-open-in-new-window",
    "allow-take-pending-navigation",
    "allow-favorites-apply",
    "allow-recent-apply",
    "allow-list-dir",
    "allow-search-files",
    "allow-list-documents",
    "allow-create-entry",
    "allow-rename-entry",
    "allow-reveal-entry",
    "allow-reconcile-disk",
    "allow-retry-tree-watch",
    "allow-open-document",
    "allow-new-untitled",
    "allow-save-untitled",
    "allow-reload-document",
    "allow-watch-document",
    "allow-unwatch-document",
    "allow-close-document",
    "allow-open-in-external-editor",
    "allow-read-asset",
    "allow-begin-edit",
    "allow-end-edit",
    "allow-render-preview",
    "allow-save-document",
    "allow-export-html",
    "allow-export-pdf",
    "allow-set-reading-progress",
    "allow-set-dir-session",
    "allow-open-link",
    "allow-report-status",
    "allow-report-measure",
    "allow-diag-note",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-destroy"
  ]
}
