# 源自 docs/bugs/0256（导出无事务性与并发锁）
# 守 --json 落点：父目录可递归创建；目标是目录/父级是文件/超长名必须失败且不留下半份 JSON；⛔ 不许与输入同路径（bugs/0289，覆盖改由另一次读+写完成）。
{"id": "bugbench-outjson-overwrite-input", "family": "bugs-bench", "argv": ["{{RMD}}", "bench", "lf.md", "--repeat", "0", "--warmup", "1", "--json", "lf.md"], "expect": {"exit": 1, "stderr_contains": ["⛔ --json", "是同一个文件"], "stdout_not_contains": ["✅ 结果写入"], "file_contains": {"lf.md": ["# 标题"]}}, "files": {"lf.md": "# 标题\n\n正文\n"}}
{"id": "bugbench-outjson-overwrite-second-input", "family": "bugs-bench", "argv": ["{{RMD}}", "bench", "a.md", "b.md", "--repeat", "0", "--warmup", "1", "--json", "b.md"], "expect": {"exit": 1, "stderr_contains": ["⛔ --json", "是同一个文件"], "stdout_not_contains": ["✅ 结果写入"], "file_contains": {"a.md": ["a\n"], "b.md": ["b\n"]}}, "files": {"a.md": "a\n", "b.md": "b\n"}}
