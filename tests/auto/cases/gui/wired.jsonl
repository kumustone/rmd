{"id":"gui-sidebar-search","family":"gui-sidebar-search","driver":"sidebar-search","argv":["make","--no-print-directory","probe-sidebar-search"],"args":["--json"],"expect":{"verdict":"pass","min_checks":9},"timeout_s":600}
{"id":"gui-link-nav","family":"gui-link-nav","driver":"link-nav","argv":["make","--no-print-directory","probe-link-nav"],"args":["--json"],"expect":{"verdict":"pass","min_checks":11},"timeout_s":600}
