{"id": "bugblk-0083-05", "family": "bugs-block", "check": "html", "input": {"md": "- ![图](a.png)\n"}, "expect": {"equals": "<ul>\n<li><img src=\"a.png\" alt=\"图\" /></li>\n</ul>\n"}}
{"id": "bugblk-0083-06", "family": "bugs-block", "check": "html", "input": {"md": "> 段落 ![图](a.png)\n"}, "expect": {"equals": "<blockquote>\n<p>段落 <img src=\"a.png\" alt=\"图\" /></p>\n</blockquote>\n"}}
# 源自 docs/bugs/0033（格内 shift-enter 能插进真实换行）：单元格文本必须原样可枚举
# 同轴：docs/bugs/0035（格内回车无法换行）、0027（进入表格单元格编辑时整张表长高 12px）、0029（表格格编辑态不换行长内容被切断）
{"id": "bugblk-0033-01", "family": "bugs-block", "check": "cells", "input": {"md": "| a |\n| --- |\n| x<br>y |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 2, "line": 3, "text": "x<br>y", "to": 8, "writable": true}]}]}}
{"id": "bugblk-0033-02", "family": "bugs-block", "check": "cells", "input": {"md": "| a |\n| --- |\n| x<br>y<br>z |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 2, "line": 3, "text": "x<br>y<br>z", "to": 13, "writable": true}]}]}}
{"id": "bugblk-0033-03", "family": "bugs-block", "check": "html", "input": {"md": "| a |\n| --- |\n| x<br>y<br>z |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>x<br />\ny<br />\nz</td>\n</tr>\n</tbody>\n</table>\n"}}
{"id": "bugblk-0033-04", "family": "bugs-block", "check": "cells", "input": {"md": "| 很长的中文内容 | b |\n| --- | --- |\n| 一二三四五六七八九十 | 2 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "很长的中文内容", "to": 9, "writable": true}, {"from": 12, "line": 1, "text": "b", "to": 13, "writable": true}, {"from": 2, "line": 3, "text": "一二三四五六七八九十", "to": 12, "writable": true}, {"from": 15, "line": 3, "text": "2", "to": 16, "writable": true}]}]}}
{"id": "bugblk-0033-05", "family": "bugs-block", "check": "html", "input": {"md": "| 很长的中文内容 | b |\n| --- | --- |\n| 一二三四五六七八九十 | 2 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>很长的中文内容</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>一二三四五六七八九十</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
{"id": "bugblk-0033-06", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| x |  |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "x", "to": 3, "writable": true}, {"from": 7, "line": 3, "text": "", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0033-07", "family": "bugs-block", "check": "blocks", "input": {"md": "| a | b |\n| --- | --- |\n| x |  |\n"}, "expect": {"count": 1, "items": [{"editable": false, "end_line": 3, "index": 0, "kind": "Table", "start_line": 1}]}}
{"id": "bugblk-0033-08", "family": "bugs-block", "check": "html", "input": {"md": "| a |\n| --- |\n| `x | y` |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>`x</td>\n</tr>\n</tbody>\n</table>\n"}}
