{"id": "bugblk-0033-19", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 | 3 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "1", "to": 3, "writable": true}, {"from": 6, "line": 3, "text": "2", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0033-20", "family": "bugs-block", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 | 3 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
