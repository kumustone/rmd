# bugs-block 家族：从 docs/bugs/ 的块级历史缺陷出发的 Rust 块级回归用例。
# 期望值按产品**当前行为**实测（2026-11-08，隔离 rust 矩阵 + comrak 0.56.0），
# 不是按 CommonMark/GFM 常识猜的；每组前的 `# 源自` 说明守的是哪次回归。
# ⚠️ 与常识不同处按实测钉住，并在注释里标『现状如此』。
# ⭐ `design/0066`（2026-11-11）：列表内的源码空行要**占版面**（`data-blanks="n"`），
# 所以松散列表的 HTML 期望值里带上了 `data-blanks`/`--rmd-blanks` 属性；没有空行的
# 紧凑列表输出⛔ 一个字节都没变。重算日期 2026-11-11，判据见 `docs/design/0066` §2。
# ----------------------------------------------------------------------
# 源自 docs/bugs/0016（只剩井号的行在编辑态被当成正文）：空 ATX 标题必须按标题解析
{"id": "bugblk-0016-01", "family": "bugs-block", "check": "html", "input": {"md": "#\n"}, "expect": {"equals": "<h1></h1>\n"}}
{"id": "bugblk-0016-02", "family": "bugs-block", "check": "html", "input": {"md": "##\n"}, "expect": {"equals": "<h2></h2>\n"}}
{"id": "bugblk-0016-03", "family": "bugs-block", "check": "html", "input": {"md": "###\n"}, "expect": {"equals": "<h3></h3>\n"}}
{"id": "bugblk-0016-04", "family": "bugs-block", "check": "html", "input": {"md": "######\n"}, "expect": {"equals": "<h6></h6>\n"}}
{"id": "bugblk-0016-05", "family": "bugs-block", "check": "html", "input": {"md": "#######\n"}, "expect": {"equals": "<p>#######</p>\n"}}
{"id": "bugblk-0016-06", "family": "bugs-block", "check": "html", "input": {"md": "#\t\n"}, "expect": {"equals": "<h1></h1>\n"}}
{"id": "bugblk-0016-07", "family": "bugs-block", "check": "html", "input": {"md": "##   \n"}, "expect": {"equals": "<h2></h2>\n"}}
{"id": "bugblk-0016-08", "family": "bugs-block", "check": "html", "input": {"md": "##\r\n"}, "expect": {"equals": "<h2></h2>\n"}}
{"id": "bugblk-0016-09", "family": "bugs-block", "check": "html", "input": {"md": "﻿##\n"}, "expect": {"equals": "<h2></h2>\n"}}
{"id": "bugblk-0016-10", "family": "bugs-block", "check": "html", "input": {"md": "#\n正文\n"}, "expect": {"equals": "<h1></h1>\n<p>正文</p>\n"}}
{"id": "bugblk-0016-11", "family": "bugs-block", "check": "html", "input": {"md": "##\n##\n"}, "expect": {"equals": "<h2></h2>\n<h2></h2>\n"}}
{"id": "bugblk-0016-12", "family": "bugs-block", "check": "html", "input": {"md": "#\n\n正文\n"}, "expect": {"equals": "<h1></h1>\n<p>正文</p>\n"}}
{"id": "bugblk-0016-13", "family": "bugs-block", "check": "html", "input": {"md": "> ##\n"}, "expect": {"equals": "<blockquote>\n<h2></h2>\n</blockquote>\n"}}
{"id": "bugblk-0016-14", "family": "bugs-block", "check": "html", "input": {"md": "- ##\n"}, "expect": {"equals": "<ul>\n<li>\n<h2></h2>\n</li>\n</ul>\n"}}
{"id": "bugblk-0016-15", "family": "bugs-block", "check": "blocks", "input": {"md": "##\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "Heading", "start_line": 1}]}}
{"id": "bugblk-0016-16", "family": "bugs-block", "check": "blocks", "input": {"md": "##\n正文\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "Heading", "start_line": 1}, {"editable": true, "end_line": 2, "index": 1, "kind": "Paragraph", "start_line": 2}]}}
{"id": "bugblk-0016-17", "family": "bugs-block", "check": "blocks", "input": {"md": "##   \n\n###\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "Heading", "start_line": 1}, {"editable": true, "end_line": 3, "index": 1, "kind": "Heading", "start_line": 3}]}}
{"id": "bugblk-0016-18", "family": "bugs-block", "check": "toc", "input": {"md": "##\n"}, "expect": {"count": 1, "items": [{"id": "", "level": 2, "line": 1, "span": [0, 2], "text": ""}]}}
{"id": "bugblk-0016-19", "family": "bugs-block", "check": "toc", "input": {"md": "#\n\n##\n"}, "expect": {"count": 2, "items": [{"id": "", "level": 1, "line": 1, "span": [0, 1], "text": ""}, {"id": "-1", "level": 2, "line": 3, "span": [3, 5], "text": ""}]}}
{"id": "bugblk-0016-20", "family": "bugs-block", "check": "toc", "input": {"md": "##\r\n"}, "expect": {"count": 1, "items": [{"id": "", "level": 2, "line": 1, "span": [0, 2], "text": ""}]}}
# 源自 docs/bugs/0021（松散列表块点不进去）：含空行的列表仍须是同一个顶层块
{"id": "bugblk-0021-01", "family": "bugs-block", "check": "html", "input": {"md": "- a\n- b\n"}, "expect": {"equals": "<ul>\n<li>a</li>\n<li>b</li>\n</ul>\n"}}
{"id": "bugblk-0021-02", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n- b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-03", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n  b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n<p data-blanks=\"1\" style=\"--rmd-blanks:1\">b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-04", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n  b\n\n- c\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n<p data-blanks=\"1\" style=\"--rmd-blanks:1\">b</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>c</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-05", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n- b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-06", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n- b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-07", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n\n- b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 4, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-08", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n正文\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "List", "start_line": 1}, {"editable": true, "end_line": 3, "index": 1, "kind": "Paragraph", "start_line": 3}]}}
{"id": "bugblk-0021-09", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n  - b\n\n- c\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 5, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-10", "family": "bugs-block", "check": "blocks", "input": {"md": "> - a\n>\n> - b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "BlockQuote", "start_line": 1}]}}
{"id": "bugblk-0021-11", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n  b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-12", "family": "bugs-block", "check": "blocks", "input": {"md": "1. a\n\n2. b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-13", "family": "bugs-block", "check": "html", "input": {"md": "1. a\n\n2. b\n"}, "expect": {"equals": "<ol>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ol>\n"}}
{"id": "bugblk-0021-14", "family": "bugs-block", "check": "html", "input": {"md": "* a\n\n* b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-15", "family": "bugs-block", "check": "html", "input": {"md": "+ a\n\n+ b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-16", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\r\n\r\n- b\r\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-17", "family": "bugs-block", "check": "html", "input": {"md": "- a\r\n\r\n- b\r\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-18", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n- b\n\n- c\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 4, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-19", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n- b\n\n段落\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}, {"editable": true, "end_line": 5, "index": 1, "kind": "Paragraph", "start_line": 5}]}}
{"id": "bugblk-0021-20", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n- b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>b</p>\n</li>\n</ul>\n"}}
{"id": "bugblk-0021-21", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n      code\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0021-22", "family": "bugs-block", "check": "html", "input": {"md": "- a\n  - b\n\n  - c\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>\n<p>b</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>c</p>\n</li>\n</ul>\n</li>\n</ul>\n"}}
# 源自 docs/bugs/0023（代码块编辑态仍显示围栏行）：CodeBlock 块范围必须含两侧围栏
{"id": "bugblk-0023-01", "family": "bugs-block", "check": "html", "input": {"md": "```\ncode\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">code\n</span></code></pre>\n"}}
{"id": "bugblk-0023-02", "family": "bugs-block", "check": "html", "input": {"md": "```rust\nfn main() {}\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code class=\"language-rust\"><span class=\"rmd-source rmd-rust\"><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-storage rmd-type rmd-function rmd-rust\">fn</span> </span><span class=\"rmd-entity rmd-name rmd-function rmd-rust\">main</span></span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-parameters rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-parameters rmd-begin rmd-rust\">(</span></span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-parameters rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-parameters rmd-end rmd-rust\">)</span></span></span></span><span class=\"rmd-meta rmd-function rmd-rust\"> </span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-block rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-block rmd-begin rmd-rust\">{</span></span><span class=\"rmd-meta rmd-block rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-block rmd-end rmd-rust\">}</span></span></span>\n</span></code></pre>\n"}}
{"id": "bugblk-0023-03", "family": "bugs-block", "check": "html", "input": {"md": "~~~rust\nfn main() {}\n~~~\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code class=\"language-rust\"><span class=\"rmd-source rmd-rust\"><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-storage rmd-type rmd-function rmd-rust\">fn</span> </span><span class=\"rmd-entity rmd-name rmd-function rmd-rust\">main</span></span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-parameters rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-parameters rmd-begin rmd-rust\">(</span></span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-function rmd-parameters rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-parameters rmd-end rmd-rust\">)</span></span></span></span><span class=\"rmd-meta rmd-function rmd-rust\"> </span><span class=\"rmd-meta rmd-function rmd-rust\"><span class=\"rmd-meta rmd-block rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-block rmd-begin rmd-rust\">{</span></span><span class=\"rmd-meta rmd-block rmd-rust\"><span class=\"rmd-punctuation rmd-section rmd-block rmd-end rmd-rust\">}</span></span></span>\n</span></code></pre>\n"}}
{"id": "bugblk-0023-04", "family": "bugs-block", "check": "html", "input": {"md": "```rust title\nx\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code class=\"language-rust\"><span class=\"rmd-source rmd-rust\">x\n</span></code></pre>\n"}}
{"id": "bugblk-0023-05", "family": "bugs-block", "check": "html", "input": {"md": "``` rust\nx\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code class=\"language-rust\"><span class=\"rmd-source rmd-rust\">x\n</span></code></pre>\n"}}
{"id": "bugblk-0023-06", "family": "bugs-block", "check": "html", "input": {"md": "```\nunclosed\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">unclosed\n</span></code></pre>\n"}}
{"id": "bugblk-0023-07", "family": "bugs-block", "check": "html", "input": {"md": "````\n```\nx\n```\n````\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">```\nx\n```\n</span></code></pre>\n"}}
{"id": "bugblk-0023-08", "family": "bugs-block", "check": "html", "input": {"md": "   ```\n   x\n   ```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">x\n</span></code></pre>\n"}}
{"id": "bugblk-0023-09", "family": "bugs-block", "check": "html", "input": {"md": "```\n\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">\n</span></code></pre>\n"}}
{"id": "bugblk-0023-10", "family": "bugs-block", "check": "html", "input": {"md": "```\na\n\nb\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">a\n\nb\n</span></code></pre>\n"}}
{"id": "bugblk-0023-11", "family": "bugs-block", "check": "blocks", "input": {"md": "```\na\nb\n```\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 4, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
{"id": "bugblk-0023-12", "family": "bugs-block", "check": "blocks", "input": {"md": "~~~\na\n~~~\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
{"id": "bugblk-0023-13", "family": "bugs-block", "check": "blocks", "input": {"md": "```\nunclosed\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
{"id": "bugblk-0023-14", "family": "bugs-block", "check": "blocks", "input": {"md": "```\n```\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
