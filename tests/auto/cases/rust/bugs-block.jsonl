{"id": "bugblk-0105-02", "family": "bugs-block", "check": "html", "input": {"md": "# *斜*\n"}, "expect": {"equals": "<h1><em>斜</em></h1>\n"}}
{"id": "bugblk-0105-03", "family": "bugs-block", "check": "html", "input": {"md": "# ***粗斜***\n"}, "expect": {"equals": "<h1><em><strong>粗斜</strong></em></h1>\n"}}
{"id": "bugblk-0105-04", "family": "bugs-block", "check": "html", "input": {"md": "# **未闭合\n"}, "expect": {"equals": "<h1>**未闭合</h1>\n"}}
{"id": "bugblk-0105-05", "family": "bugs-block", "check": "html", "input": {"md": "# a_b_c\n"}, "expect": {"equals": "<h1>a_b_c</h1>\n"}}
{"id": "bugblk-0105-06", "family": "bugs-block", "check": "html", "input": {"md": "# a*b*c\n"}, "expect": {"equals": "<h1>a<em>b</em>c</h1>\n"}}
{"id": "bugblk-0105-07", "family": "bugs-block", "check": "html", "input": {"md": "# ~~删~~\n"}, "expect": {"equals": "<h1><del>删</del></h1>\n"}}
{"id": "bugblk-0105-08", "family": "bugs-block", "check": "html", "input": {"md": "# [链接](https://example.com)\n"}, "expect": {"equals": "<h1><a href=\"https://example.com\">链接</a></h1>\n"}}
{"id": "bugblk-0105-09", "family": "bugs-block", "check": "html", "input": {"md": "# `代码`\n"}, "expect": {"equals": "<h1><code>代码</code></h1>\n"}}
{"id": "bugblk-0105-10", "family": "bugs-block", "check": "html", "input": {"md": "# \\*字面\\*\n"}, "expect": {"equals": "<h1>*字面*</h1>\n"}}
{"id": "bugblk-0105-11", "family": "bugs-block", "check": "html", "input": {"md": "# **粗** 与 *斜*\n"}, "expect": {"equals": "<h1><strong>粗</strong> 与 <em>斜</em></h1>\n"}}
{"id": "bugblk-0105-12", "family": "bugs-block", "check": "html", "input": {"md": "# a **b** c\n"}, "expect": {"equals": "<h1>a <strong>b</strong> c</h1>\n"}}
{"id": "bugblk-0105-13", "family": "bugs-block", "check": "html", "input": {"md": "## *斜* 标题\n"}, "expect": {"equals": "<h2><em>斜</em> 标题</h2>\n"}}
{"id": "bugblk-0105-14", "family": "bugs-block", "check": "toc", "input": {"md": "# **粗** 与 *斜*\n"}, "expect": {"count": 1, "items": [{"id": "粗-与-斜", "level": 1, "line": 1, "span": [0, 19], "text": "粗 与 斜"}]}}
{"id": "bugblk-0105-15", "family": "bugs-block", "check": "toc", "input": {"md": "# `代码`\n"}, "expect": {"count": 1, "items": [{"id": "代码", "level": 1, "line": 1, "span": [0, 10], "text": "代码"}]}}
{"id": "bugblk-0105-16", "family": "bugs-block", "check": "blocks", "input": {"md": "# **粗**\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "Heading", "start_line": 1}]}}
{"id": "bugblk-0105-17", "family": "bugs-block", "check": "html", "input": {"md": "# **粗**\n# *斜*\n"}, "expect": {"equals": "<h1><strong>粗</strong></h1>\n<h1><em>斜</em></h1>\n"}}
{"id": "bugblk-0105-18", "family": "bugs-block", "check": "html", "input": {"md": "# snake_case_name\n"}, "expect": {"equals": "<h1>snake_case_name</h1>\n"}}
{"id": "bugblk-0105-19", "family": "bugs-block", "check": "html", "input": {"md": "# __粗__\n"}, "expect": {"equals": "<h1><strong>粗</strong></h1>\n"}}
{"id": "bugblk-0105-20", "family": "bugs-block", "check": "html", "input": {"md": "# _斜_\n"}, "expect": {"equals": "<h1><em>斜</em></h1>\n"}}
{"id": "bugblk-0105-21", "family": "bugs-block", "check": "html", "input": {"md": "# ~~**双**~~\n"}, "expect": {"equals": "<h1><del><strong>双</strong></del></h1>\n"}}
# 源自 docs/bugs/0111（编辑态回车与退格在引用和嵌套列表中的行为缺口）：嵌套层级必须解析成确定性结构
{"id": "bugblk-0111-01", "family": "bugs-block", "check": "html", "input": {"md": "- a\n  - b\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-02", "family": "bugs-block", "check": "html", "input": {"md": "- a\n    - b\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-03", "family": "bugs-block", "check": "html", "input": {"md": "- a\n   - b\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-04", "family": "bugs-block", "check": "html", "input": {"md": "1. a\n   1. b\n"}, "expect": {"equals": "<ol>\n<li>a\n<ol>\n<li>b</li>\n</ol>\n</li>\n</ol>\n"}}
{"id": "bugblk-0111-05", "family": "bugs-block", "check": "html", "input": {"md": "1. a\n  - b\n"}, "expect": {"equals": "<ol>\n<li>a</li>\n</ol>\n<ul>\n<li>b</li>\n</ul>\n"}}
{"id": "bugblk-0111-06", "family": "bugs-block", "check": "html", "input": {"md": "- a\n  - b\n    - c\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>b\n<ul>\n<li>c</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-07", "family": "bugs-block", "check": "html", "input": {"md": "- > 引用\n"}, "expect": {"equals": "<ul>\n<li>\n<blockquote>\n<p>引用</p>\n</blockquote>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-08", "family": "bugs-block", "check": "html", "input": {"md": "> - a\n>   - b\n"}, "expect": {"equals": "<blockquote>\n<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n</blockquote>\n"}}
{"id": "bugblk-0111-09", "family": "bugs-block", "check": "html", "input": {"md": "> > - a\n"}, "expect": {"equals": "<blockquote>\n<blockquote>\n<ul>\n<li>a</li>\n</ul>\n</blockquote>\n</blockquote>\n"}}
{"id": "bugblk-0111-10", "family": "bugs-block", "check": "html", "input": {"md": "10. a\n    1. b\n"}, "expect": {"equals": "<ol start=\"10\">\n<li>a\n<ol>\n<li>b</li>\n</ol>\n</li>\n</ol>\n"}}
{"id": "bugblk-0111-11", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n  - b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0111-12", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n  - b\n    - c\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0111-13", "family": "bugs-block", "check": "blocks", "input": {"md": "1. a\n  - b\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "List", "start_line": 1}, {"editable": true, "end_line": 2, "index": 1, "kind": "List", "start_line": 2}]}}
{"id": "bugblk-0111-14", "family": "bugs-block", "check": "blocks", "input": {"md": "> - a\n>   - b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "BlockQuote", "start_line": 1}]}}
{"id": "bugblk-0111-15", "family": "bugs-block", "check": "html", "input": {"md": "- a\n  b\n"}, "expect": {"equals": "<ul>\n<li>a<br />\nb</li>\n</ul>\n"}}
{"id": "bugblk-0111-16", "family": "bugs-block", "check": "html", "input": {"md": "- a\n    b\n"}, "expect": {"equals": "<ul>\n<li>a<br />\nb</li>\n</ul>\n"}}
{"id": "bugblk-0111-17", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n  b\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0111-18", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n  - b\n\n  - c\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n<ul data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<li>\n<p>b</p>\n</li>\n<li data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<p>c</p>\n</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-19", "family": "bugs-block", "check": "blocks", "input": {"md": "- a\n\n  - b\n\n  - c\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 5, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0111-20", "family": "bugs-block", "check": "html", "input": {"md": "- a\r\n  - b\r\n"}, "expect": {"equals": "<ul>\n<li>a\n<ul>\n<li>b</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0111-21", "family": "bugs-block", "check": "html", "input": {"md": "123. a\n     1. b\n"}, "expect": {"equals": "<ol start=\"123\">\n<li>a\n<ol>\n<li>b</li>\n</ol>\n</li>\n</ol>\n"}}
{"id": "bugblk-0111-22", "family": "bugs-block", "check": "html", "input": {"md": "- a\n\n  段二\n\n  - b\n"}, "expect": {"equals": "<ul>\n<li>\n<p>a</p>\n<p data-blanks=\"1\" style=\"--rmd-blanks:1\">段二</p>\n<ul data-blanks=\"1\" style=\"--rmd-blanks:1\">\n<li>b</li>\n</ul>\n</li>\n</ul>\n"}}
# 源自 docs/bugs/0152（嵌套任务项筛选用子串计数）：嵌套任务项必须按真实块/行返回，不能按文本混算
{"id": "bugblk-0152-01", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 顶层\n  - [ ] 嵌套\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 2, "symbol": " ", "to": 6, "writable": true}]}]}}
{"id": "bugblk-0152-02", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\n  - [ ] 二\n    - [x] 三\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 2, "symbol": " ", "to": 6, "writable": true}, {"checked": true, "from": 7, "line": 3, "symbol": "x", "to": 8, "writable": true}]}]}}
{"id": "bugblk-0152-03", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\n  - [ ] 二\n\n- [ ] 三\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 2, "symbol": " ", "to": 6, "writable": true}, {"checked": false, "from": 3, "line": 4, "symbol": " ", "to": 4, "writable": true}]}]}}
{"id": "bugblk-0152-04", "family": "bugs-block", "check": "tasks", "input": {"md": "> - [x] 引用顶层\n>   - [ ] 引用嵌套\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 5, "line": 1, "symbol": "x", "to": 6, "writable": true}, {"checked": false, "from": 7, "line": 2, "symbol": " ", "to": 8, "writable": true}]}]}}
{"id": "bugblk-0152-05", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\n\n- [ ] 二\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 3, "line": 3, "symbol": " ", "to": 4, "writable": true}]}]}}
{"id": "bugblk-0152-06", "family": "bugs-block", "check": "tasks", "input": {"md": "1. [x] 有序一\n   - [ ] 嵌套\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 4, "line": 1, "symbol": "x", "to": 5, "writable": true}, {"checked": false, "from": 6, "line": 2, "symbol": " ", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0152-07", "family": "bugs-block", "check": "tasks", "input": {"md": "  - [x] 缩进顶层\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 5, "line": 1, "symbol": "x", "to": 6, "writable": true}]}]}}
{"id": "bugblk-0152-08", "family": "bugs-block", "check": "blocks", "input": {"md": "- [x] 一\n  - [ ] 二\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 2, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0152-09", "family": "bugs-block", "check": "html", "input": {"md": "- [x] 一\n  - [ ] 二\n"}, "expect": {"equals": "<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" checked=\"\" disabled=\"\" /> 一\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" disabled=\"\" /> 二</li>\n</ul>\n</li>\n</ul>\n"}}
{"id": "bugblk-0152-10", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\n\n  - [ ] 二\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 3, "symbol": " ", "to": 6, "writable": true}]}]}}
{"id": "bugblk-0152-11", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\r\n  - [ ] 二\r\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 2, "symbol": " ", "to": 6, "writable": true}]}]}}
{"id": "bugblk-0152-12", "family": "bugs-block", "check": "tasks", "input": {"md": "- [x] 一\n- [ ] 二\n  - [x] 三\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": true, "from": 3, "line": 1, "symbol": "x", "to": 4, "writable": true}, {"checked": false, "from": 3, "line": 2, "symbol": " ", "to": 4, "writable": true}, {"checked": true, "from": 5, "line": 3, "symbol": "x", "to": 6, "writable": true}]}]}}
{"id": "bugblk-0152-13", "family": "bugs-block", "check": "html", "input": {"md": "1. [x] 一\n   - [ ] 二\n"}, "expect": {"equals": "<ol class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" checked=\"\" disabled=\"\" /> 一\n<ul class=\"contains-task-list\">\n<li class=\"task-list-item\"><input type=\"checkbox\" class=\"task-list-item-checkbox\" disabled=\"\" /> 二</li>\n</ul>\n</li>\n</ol>\n"}}
{"id": "bugblk-0152-14", "family": "bugs-block", "check": "blocks", "input": {"md": "- [x] 一\n\n- [ ] 二\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0152-15", "family": "bugs-block", "check": "tasks", "input": {"md": "- [ ] 一\n  - [ ] 二\n    - [ ] 三\n      - [ ] 四\n"}, "expect": {"count": 1, "items": [{"block": 0, "items": [{"checked": false, "from": 3, "line": 1, "symbol": " ", "to": 4, "writable": true}, {"checked": false, "from": 5, "line": 2, "symbol": " ", "to": 6, "writable": true}, {"checked": false, "from": 7, "line": 3, "symbol": " ", "to": 8, "writable": true}, {"checked": false, "from": 9, "line": 4, "symbol": " ", "to": 10, "writable": true}]}]}}
# 源自 docs/bugs/0069（表格格子里点行尾不出光标）：格区间必须是 UTF-16 右开
# 同轴：docs/bugs/0084（阅读态点格内行尾少算隐藏标记）、docs/bugs/0104（表格方向键不能跨格）
{"id": "bugblk-0069-01", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "1", "to": 3, "writable": true}, {"from": 6, "line": 3, "text": "2", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0069-02", "family": "bugs-block", "check": "cells", "input": {"md": "|a|b|\n|-|-|\n|1|2|\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 1, "line": 1, "text": "a", "to": 2, "writable": true}, {"from": 3, "line": 1, "text": "b", "to": 4, "writable": true}, {"from": 1, "line": 3, "text": "1", "to": 2, "writable": true}, {"from": 3, "line": 3, "text": "2", "to": 4, "writable": true}]}]}}
{"id": "bugblk-0069-03", "family": "bugs-block", "check": "cells", "input": {"md": "| 甲 | 乙 |\n| --- | --- |\n| 一 | 二 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "甲", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "乙", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "一", "to": 3, "writable": true}, {"from": 6, "line": 3, "text": "二", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0069-04", "family": "bugs-block", "check": "cells", "input": {"md": "| 🙂 | 乙 |\n| --- | --- |\n| 一 | 二 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "🙂", "to": 4, "writable": true}, {"from": 7, "line": 1, "text": "乙", "to": 8, "writable": true}, {"from": 2, "line": 3, "text": "一", "to": 3, "writable": true}, {"from": 6, "line": 3, "text": "二", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0069-05", "family": "bugs-block", "check": "cells", "input": {"md": "|  a  |  b  |\n| --- | --- |\n|  1  |  2  |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 3, "line": 1, "text": "a", "to": 4, "writable": true}, {"from": 9, "line": 1, "text": "b", "to": 10, "writable": true}, {"from": 3, "line": 3, "text": "1", "to": 4, "writable": true}, {"from": 9, "line": 3, "text": "2", "to": 10, "writable": true}]}]}}
{"id": "bugblk-0069-06", "family": "bugs-block", "check": "cells", "input": {"md": "|  | b |\n| --- | --- |\n| 1 |  |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 3, "line": 1, "text": "", "to": 3, "writable": true}, {"from": 5, "line": 1, "text": "b", "to": 6, "writable": true}, {"from": 2, "line": 3, "text": "1", "to": 3, "writable": true}, {"from": 7, "line": 3, "text": "", "to": 7, "writable": true}]}]}}
{"id": "bugblk-0069-07", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| x \\| y | z |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "x \\| y", "to": 8, "writable": true}, {"from": 11, "line": 3, "text": "z", "to": 12, "writable": true}]}]}}
