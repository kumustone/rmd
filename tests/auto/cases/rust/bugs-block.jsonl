{"id": "bugblk-0037-24", "family": "bugs-block", "check": "blocks", "input": {"md": "段落[^a]\n\n[^a]: 一\n\n[^b]: 二\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 1, "index": 0, "kind": "Paragraph", "start_line": 1}, {"editable": false, "end_line": 3, "index": 1, "kind": "FootnoteDefinition", "start_line": 3}]}}
