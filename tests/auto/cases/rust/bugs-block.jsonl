{"id": "bugblk-0023-17", "family": "bugs-block", "check": "blocks", "input": {"md": "```\nx\n```\np\n"}, "expect": {"count": 2, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "CodeBlock", "start_line": 1}, {"editable": true, "end_line": 4, "index": 1, "kind": "Paragraph", "start_line": 4}]}}
{"id": "bugblk-0023-18", "family": "bugs-block", "check": "blocks", "input": {"md": "   ```\n   x\n   ```\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
{"id": "bugblk-0023-19", "family": "bugs-block", "check": "blocks", "input": {"md": "```\r\nx\r\n```\r\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "CodeBlock", "start_line": 1}]}}
{"id": "bugblk-0023-20", "family": "bugs-block", "check": "blocks", "input": {"md": "- ```\n  x\n  ```\n"}, "expect": {"count": 1, "items": [{"editable": true, "end_line": 3, "index": 0, "kind": "List", "start_line": 1}]}}
{"id": "bugblk-0023-21", "family": "bugs-block", "check": "html", "input": {"md": "~~~\ncode\n~~~\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">code\n</span></code></pre>\n"}}
{"id": "bugblk-0023-22", "family": "bugs-block", "check": "html", "input": {"md": "```\nx\n```   \n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">x\n</span></code></pre>\n"}}
{"id": "bugblk-0023-23", "family": "bugs-block", "check": "html", "input": {"md": "```\nx\n   ```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code><span class=\"rmd-text rmd-plain\">x\n</span></code></pre>\n"}}
{"id": "bugblk-0023-24", "family": "bugs-block", "check": "html", "input": {"md": "```yaml\nkey: 1\n```\n"}, "expect": {"equals": "<pre class=\"rmd-code\"><code class=\"language-yaml\"><span class=\"rmd-source rmd-yaml\"><span class=\"rmd-string rmd-unquoted rmd-plain rmd-out rmd-yaml\"><span class=\"rmd-entity rmd-name rmd-tag rmd-yaml\">key</span></span><span class=\"rmd-punctuation rmd-separator rmd-key-value rmd-mapping rmd-yaml\">:</span> <span class=\"rmd-constant rmd-numeric rmd-integer rmd-yaml\">1</span>\n</span></code></pre>\n"}}
# 源自 docs/bugs/0032（格内末尾反斜杠会合并相邻单元格）：转义竖线必须留在格内
{"id": "bugblk-0032-01", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n|z\\|y|\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 1, "line": 3, "text": "z\\|y", "to": 5, "writable": true}, {"from": 0, "line": 3, "text": "", "to": 0, "writable": false}]}]}}
{"id": "bugblk-0032-02", "family": "bugs-block", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n|z\\|y|\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>z|y</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n"}}
{"id": "bugblk-0032-03", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| a\\|b | c |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "a\\|b", "to": 6, "writable": true}, {"from": 9, "line": 3, "text": "c", "to": 10, "writable": true}]}]}}
