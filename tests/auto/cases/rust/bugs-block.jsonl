{"id": "bugblk-0033-13", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| **粗** | *斜* |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "**粗**", "to": 7, "writable": true}, {"from": 10, "line": 3, "text": "*斜*", "to": 13, "writable": true}]}]}}
