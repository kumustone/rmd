{"id": "bugblk-0015-05", "family": "bugs-block", "check": "html", "input": {"md": "# 标题\n| a |\n| --- |\n| 1 |\n"}, "expect": {"equals": "<h1>标题</h1>\n<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n</tr>\n</tbody>\n</table>\n"}}
