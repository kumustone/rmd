{"id": "bugblk-0033-16", "family": "bugs-block", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n| 3 | 4 |\n| 5 | 6 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n<tr>\n<td>3</td>\n<td>4</td>\n</tr>\n<tr>\n<td>5</td>\n<td>6</td>\n</tr>\n</tbody>\n</table>\n"}}
{"id": "bugblk-0033-17", "family": "bugs-block", "check": "cells", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n| 3 |\n"}, "expect": {"count": 1, "items": [{"block": 0, "cells": [{"from": 2, "line": 1, "text": "a", "to": 3, "writable": true}, {"from": 6, "line": 1, "text": "b", "to": 7, "writable": true}, {"from": 2, "line": 3, "text": "1", "to": 3, "writable": true}, {"from": 6, "line": 3, "text": "2", "to": 7, "writable": true}, {"from": 2, "line": 4, "text": "3", "to": 3, "writable": true}, {"from": 0, "line": 4, "text": "", "to": 0, "writable": false}]}]}}
