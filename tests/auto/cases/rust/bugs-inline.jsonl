{"id":"buginl-0035-br-in-header-cell","name":"表头里的 br 也变成换行","family":"bugs-inline","check":"html","input":{"md":"| a<br>b |\n| - |\n| x |\n"},"expect":{"contains":["<th>a<br />\nb</th>"]}}
