{"id":"buginl-0037-def-with-link","name":"脚注定义里的链接","family":"bugs-inline","check":"html","input":{"md":"a[^1]\n\n[^1]: 有 [链](u)\n"},"expect":{"contains":["<a href=\"u\">链</a>","class=\"footnote-backref\""]}}
