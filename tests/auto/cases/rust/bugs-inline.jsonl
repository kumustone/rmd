{"id":"buginl-0035-br-space-in-table","name":"表格格里带空格 br 变成换行","family":"bugs-inline","check":"html","input":{"md":"| a |\n| - |\n| x<br />y |\n"},"expect":{"contains":["<td>x<br />\ny</td>"]}}
