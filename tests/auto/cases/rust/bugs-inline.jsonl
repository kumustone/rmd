{"id":"buginl-0035-br-sourcepos-in-table","name":"表格格里 br 的 sourcepos 保留","family":"bugs-inline","check":"html","input":{"md":"| a |\n| - |\n| x<br>y |\n","opts":{"render_sourcepos":true}},"expect":{"contains":["<br data-sourcepos=\"3:4-3:7\" />"]}}
{"id":"buginl-0035-two-br-in-table","name":"表格格里两个 br 生成两个换行","family":"bugs-inline","check":"html","input":{"md":"| a |\n| - |\n| x<br>y<br>z |\n"},"expect":{"counts":{"<br />":2}}}
