{"id":"buginl-0075-math-inline-cjk","name":"中文紧邻行内公式","family":"bugs-inline","check":"html","input":{"md":"中文$x$中文\n"},"expect":{"contains":["中文<span class=\"rmd-math-inline\">","</span>中文"],"not_contains":["<p>中文$x$"]}}
{"id":"buginl-0075-math-inline-in-link","name":"链接文字里的行内公式","family":"bugs-inline","check":"html","input":{"md":"[$x$](u)\n"},"expect":{"contains":["<a href=\"u\"><span class=\"rmd-math-inline\">"],"counts":{"rmd-math-inline":1}}}
{"id":"buginl-0075-math-inline-in-em","name":"斜体里的行内公式","family":"bugs-inline","check":"html","input":{"md":"*$x$*\n"},"expect":{"contains":["<em><span class=\"rmd-math-inline\">"],"counts":{"<em>":1}}}
{"id":"buginl-0075-math-inline-in-strong","name":"加粗里的行内公式","family":"bugs-inline","check":"html","input":{"md":"**$x$**\n"},"expect":{"contains":["<strong><span class=\"rmd-math-inline\">"],"counts":{"<strong>":1}}}
{"id":"buginl-0075-math-escaped-open","name":"转义左美元号不成公式","family":"bugs-inline","check":"html","input":{"md":"\\$x$\n"},"expect":{"contains":["<p>$x$</p>"],"not_contains":["rmd-math-inline"]}}
{"id":"buginl-0075-math-escaped-close","name":"转义右美元号不成公式","family":"bugs-inline","check":"html","input":{"md":"$x\\$\n"},"expect":{"contains":["<p>$x$</p>"],"not_contains":["rmd-math-inline"]}}
{"id":"buginl-0075-math-unclosed","name":"未闭合美元号保持字面","family":"bugs-inline","check":"html","input":{"md":"$x\n"},"expect":{"equals":"<p>$x</p>\n"}}
{"id":"buginl-0075-math-currency","name":"货币金额不构成公式","family":"bugs-inline","check":"html","input":{"md":"$100 和 $200\n"},"expect":{"equals":"<p>$100 和 $200</p>\n"}}
{"id":"buginl-0075-math-block-alone","name":"整段块级公式不套 p","family":"bugs-inline","check":"html","input":{"md":"$$\nx^2\n$$\n"},"expect":{"contains":["<div class=\"rmd-math-display\">","<annotation encoding=\"application/x-tex\">x^2</annotation>"],"not_contains":["<p>"]}}
{"id":"buginl-0075-math-block-same-line","name":"单行块级公式不套 p","family":"bugs-inline","check":"html","input":{"md":"$$x$$\n"},"expect":{"contains":["<div class=\"rmd-math-display\">"],"not_contains":["<p>"]}}
{"id":"buginl-0075-math-block-multiline","name":"多行块级公式","family":"bugs-inline","check":"html","input":{"md":"$$\nE = mc^2\n$$\n"},"expect":{"contains":["<div class=\"rmd-math-display\">","<annotation encoding=\"application/x-tex\">E = mc^2</annotation>"],"not_contains":["<p>"]}}
# ⚠️ 疑似缺陷：整段不是纯块级公式时输出 <p> 里套 <div>，浏览器会提前闭合 <p>，DOM 结构与源码不一致
{"id":"buginl-0075-math-block-trailing-text","name":"块级公式后同一段还有文字","family":"bugs-inline","check":"html","input":{"md":"$$x$$ 后文\n"},"expect":{"contains":["<p><div class=\"rmd-math-display\">","后文"]}}
# ⚠️ 疑似缺陷：整段不是纯块级公式时输出 <p> 里套 <div>，浏览器会提前闭合 <p>，DOM 结构与源码不一致
{"id":"buginl-0075-math-block-leading-text","name":"文字在块级公式之前","family":"bugs-inline","check":"html","input":{"md":"前文 $$x$$\n"},"expect":{"contains":["<div class=\"rmd-math-display\">","前文"]}}
# ⚠️ 疑似缺陷：整段不是纯块级公式时输出 <p> 里套 <div>，浏览器会提前闭合 <p>，DOM 结构与源码不一致
{"id":"buginl-0075-math-block-between-text","name":"文字夹在两个块级公式表达式之间","family":"bugs-inline","check":"html","input":{"md":"前 $$x$$ 后\n"},"expect":{"contains":["<div class=\"rmd-math-display\">","前 ","后"]}}
{"id":"buginl-0075-math-in-code","name":"行内代码里的美元号不是公式","family":"bugs-inline","check":"html","input":{"md":"`$x$`\n"},"expect":{"equals":"<p><code>$x$</code></p>\n"}}
{"id":"buginl-0075-math-in-url","name":"链接目标里的美元号不是公式","family":"bugs-inline","check":"html","input":{"md":"[x](https://e.com/$a$)\n"},"expect":{"equals":"<p><a href=\"https://e.com/$a$\">x</a></p>\n"}}
{"id":"buginl-0075-math-off","name":"关闭 math_dollars 后行内美元号保持字面","family":"bugs-inline","check":"html","input":{"md":"$x$\n","opts":{"math_dollars":false}},"expect":{"contains":["<p>$x$</p>"],"not_contains":["rmd-math-inline"]}}
{"id":"buginl-0075-math-off-block","name":"关闭 math_dollars 后块级美元号保持字面","family":"bugs-inline","check":"html","input":{"md":"$$x$$\n","opts":{"math_dollars":false}},"expect":{"contains":["<p>$$x$$</p>"],"not_contains":["rmd-math-display"]}}
