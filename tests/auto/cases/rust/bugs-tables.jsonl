{"id": "bugtbl-0169-54-格内伪标题不入目录", "family": "bugs-tables", "check": "toc", "input": {"md": "| # 假 | b |\n| --- | --- |\n| ## 假二 | x |\n\n# 真\n"}, "expect": {"count": 1, "items": [{"id": "真", "level": 1, "line": 5, "span": [47, 52], "text": "真"}]}}
