# 源自 docs/bugs/0113（编辑态与阅读态排版基准对齐候选）
# 第三组：疑似缺陷的现状引脚。它们**不是**期望行为，只是防止在修好之前悄悄变化。
# ⚠️ 疑似缺陷：表后无空行的正文被当成表格行
{"id": "bugtbl-0113-51-表后正文被吞现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n尾巴文字\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n<tr>\n<td>尾巴文字</td>\n<td></td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：列表后紧跟的表格不渲染成表
{"id": "bugtbl-0113-52-列表后表格被吞现状", "family": "bugs-tables", "check": "html", "input": {"md": "- 项\n| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"contains": ["<li>项<br />", "| a | b |"]}}
# ⚠️ 疑似缺陷：引用后紧跟的表格被吞进段落
{"id": "bugtbl-0113-53-引用后表格被吞现状", "family": "bugs-tables", "check": "html", "input": {"md": "> 引用\n| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"contains": ["<p>引用<br />", "| a | b |"]}}
# ⚠️ 疑似缺陷：多写的单元格被静默丢弃
{"id": "bugtbl-0113-54-多写两格被丢弃现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 | 3 | 4 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：NBSP 不被当填充空白修剪
{"id": "bugtbl-0113-55-NBSP不修剪现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a  | b |\n| --- | --- |\n|  1  | 2 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a </th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td> 1 </td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：分隔行列数不符时整表退化成段落
{"id": "bugtbl-0113-56-分隔行列数不符现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c |\n| --- | --- |\n| 1 | 2 | 3 |\n"}, "expect": {"contains": ["<p>", "| a | b | c |"]}}
# ⚠️ 疑似缺陷：冒号与减号间有空格时整表退化成段落
{"id": "bugtbl-0113-57-冒号空格现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| : --- | ---: |\n| 1 | 2 |\n"}, "expect": {"contains": ["<p>", "| : --- |"]}}
# ⚠️ 疑似缺陷：带属性的 br 不算换行，变成被丢弃的原始 HTML
{"id": "bugtbl-0113-58-br属性现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a |\n| --- |\n| x<br class=\"c\">y |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>x<!-- raw HTML omitted -->y</td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：代码 span 内未转义竖线被当分隔符
{"id": "bugtbl-0113-59-代码span竖线现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| `x|y` | z |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>`x</td>\n<td>y`</td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：四格缩进的表被当成代码块
{"id": "bugtbl-0113-60-四格缩进现状", "family": "bugs-tables", "check": "html", "input": {"md": "    | a | b |\n    | --- | --- |\n    | 1 | 2 |\n"}, "expect": {"contains": ["<pre class=\"rmd-code\">"]}}
# ⚠️ 疑似缺陷：单列表格不写竖线时被当成 Setext 标题
{"id": "bugtbl-0113-61-单列无竖线现状", "family": "bugs-tables", "check": "html", "input": {"md": "a\n---\n1\n"}, "expect": {"equals": "<h2>a</h2>\n<p>1</p>\n"}}
# ⚠️ 疑似缺陷：第二行只有减号时按 Setext 解析，不是表格
{"id": "bugtbl-0113-62-管道后减号现状", "family": "bugs-tables", "check": "html", "input": {"md": "a | b\n---\n1 | 2\n"}, "expect": {"equals": "<h2>a | b</h2>\n<p>1 | 2</p>\n"}}
# ⚠️ 疑似缺陷：只有一个竖线的体行被完全丢弃
{"id": "bugtbl-0113-63-单竖线体行现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n|\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n</table>\n<p>|</p>\n"}}
# ⚠️ 疑似缺陷：两表之间无空行时后表被当成前一表的体行
{"id": "bugtbl-0113-64-两表无空行现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a |\n| --- |\n| 1 |\n| b |\n| 2 |\n"}, "expect": {"counts": {"<table>": 1, "<tr>": 4}}}
# ⚠️ 观察：全角竖线不是 GFM 分隔符（现状正确，防止被误改）
{"id": "bugtbl-0113-65-全角竖线不切现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a ｜ b | c |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a ｜ b</th>\n<th>c</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
# ⚠️ 疑似缺陷：分隔行多一列时整表退化成段落
{"id": "bugtbl-0113-66-分隔行多列现状", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- | --- |\n| 1 | 2 |\n"}, "expect": {"contains": ["<p>", "| --- | --- | --- |"]}}
