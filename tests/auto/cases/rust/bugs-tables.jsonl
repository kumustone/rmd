{"id": "bugtbl-0113-03-表前标题空行", "family": "bugs-tables", "check": "html", "input": {"md": "# 标题\n\n| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"equals": "<h1>标题</h1>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
{"id": "bugtbl-0113-04-表前标题无空行", "family": "bugs-tables", "check": "html", "input": {"md": "# 标题\n| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"equals": "<h1>标题</h1>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
