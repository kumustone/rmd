{"id": "bugtbl-0133-13-引用块内表格计数", "family": "bugs-tables", "check": "html", "input": {"md": "> | a | b |\n> | --- | --- |\n> | 1 | 2 |\n"}, "expect": {"counts": {"<table>": 1, "</th>": 2, "<td": 2}, "contains": ["<blockquote>"]}}
{"id": "bugtbl-0133-14-列表内表格计数", "family": "bugs-tables", "check": "html", "input": {"md": "- | a | b |\n  | --- | --- |\n  | 1 | 2 |\n"}, "expect": {"counts": {"<table>": 1, "</th>": 2, "<td": 2}, "contains": ["<li>"]}}
{"id": "bugtbl-0133-15-CRLF计数不变", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\r\n| --- | --- |\r\n| 1 | 2 |\r\n"}, "expect": {"counts": {"<tr>": 2, "</th>": 2, "<td": 2}}}
