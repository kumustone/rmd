{"id": "bugtbl-0169-60-表后无空行标题", "family": "bugs-tables", "check": "toc", "input": {"md": "| a |\n| --- |\n| 1 |\n# h\n"}, "expect": {"count": 1, "items": [{"id": "h", "level": 1, "line": 4, "span": [20, 23], "text": "h"}]}}
