# 源自 docs/bugs/0133（M3表格变异两条必须红打不红）
# 结构断言必须真的能从 HTML 里数出来：表头/表体、行数、每行格数、对齐。
{"id": "bugtbl-0133-01-两行两列计数", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"counts": {"<table>": 1, "<tr>": 2, "</th>": 2, "<td": 2, "</table>": 1}}}
{"id": "bugtbl-0133-02-三行三列计数", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c |\n| --- | --- | --- |\n| 1 | 2 | 3 |\n| 4 | 5 | 6 |\n"}, "expect": {"counts": {"<tr>": 3, "</th>": 3, "<td": 6}}}
{"id": "bugtbl-0133-03-只有表头无tbody", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n"}, "expect": {"counts": {"<tr>": 1, "</th>": 2, "<td": 0}, "not_contains": ["<tbody>"]}}
{"id": "bugtbl-0133-04-少列补空格数不变", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c |\n| --- | --- | --- |\n| 1 |\n"}, "expect": {"counts": {"</th>": 3, "<td": 3}, "contains": ["<td></td>", "<td></td>"]}}
{"id": "bugtbl-0133-05-多列被丢弃格数不变", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c |\n| --- | --- | --- |\n| 1 | 2 | 3 | 4 | 5 |\n"}, "expect": {"counts": {"<td": 3}, "not_contains": ["<td>4</td>", "<td>5</td>"]}}
{"id": "bugtbl-0133-06-分隔行列数不符不是表", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c |\n| --- | --- |\n| 1 | 2 | 3 |\n"}, "expect": {"not_contains": ["<table>", "<th>"], "contains": ["<p>"]}}
{"id": "bugtbl-0133-07-两表计数", "family": "bugs-tables", "check": "html", "input": {"md": "| a |\n| --- |\n| 1 |\n\n| b |\n| --- |\n| 2 |\n"}, "expect": {"counts": {"<table>": 2, "</th>": 2, "<td": 2}}}
{"id": "bugtbl-0133-08-空体行仍占格", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n|  |  |\n"}, "expect": {"counts": {"<td": 2, "<tr>": 2}}}
{"id": "bugtbl-0133-09-单列计数", "family": "bugs-tables", "check": "html", "input": {"md": "| a |\n| --- |\n| 1 |\n"}, "expect": {"counts": {"</th>": 1, "<td": 1, "<tr>": 2}}}
{"id": "bugtbl-0133-10-四列对齐属性计数", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b | c | d |\n| :--- | :---: | ---: | --- |\n| 1 | 2 | 3 | 4 |\n"}, "expect": {"counts": {"align=\"left\"": 2, "align=\"center\"": 2, "align=\"right\"": 2}}}
{"id": "bugtbl-0133-11-无对齐不出属性", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| --- | --- |\n| 1 | 2 |\n"}, "expect": {"not_contains": ["align="]}}
