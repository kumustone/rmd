{"id": "bugtbl-0169-07-长分隔线", "family": "bugs-tables", "check": "html", "input": {"md": "| a | b |\n| -------- | -------- |\n| 1 | 2 |\n"}, "expect": {"equals": "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>1</td>\n<td>2</td>\n</tr>\n</tbody>\n</table>\n"}}
