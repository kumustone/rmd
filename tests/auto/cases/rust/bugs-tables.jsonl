{"id": "bugtbl-0169-56-重复标题加后缀", "family": "bugs-tables", "check": "toc", "input": {"md": "# 表\n\n| a |\n| --- |\n| 1 |\n\n# 表\n"}, "expect": {"count": 2, "items": [{"id": "表", "level": 1, "line": 1, "span": [0, 5], "text": "表"}, {"id": "表-1", "level": 1, "line": 7, "span": [28, 33], "text": "表"}]}}
