{"id": "mdblock-HTML块不可编辑", "family": "md-block", "check": "blocks", "input": {"md": "<div>块</div>\n"}, "expect": {"count": 1, "items": [{"index": 0, "kind": "HtmlBlock", "start_line": 1, "end_line": 1, "editable": false}]}}
