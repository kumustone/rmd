{"id": "mdblock-小写toc指令剥离", "family": "md-block", "check": "html", "input": {"md": "[toc]\n"}, "expect": {"equals": ""}}
{"id": "mdblock-混合大小写TOC剥离", "family": "md-block", "check": "html", "input": {"md": "[ToC]\n"}, "expect": {"equals": ""}}
{"id": "mdblock-TOC尾随空格仍剥离", "family": "md-block", "check": "html", "input": {"md": "[TOC]  \n"}, "expect": {"equals": ""}}
{"id": "mdblock-at指令段落剥离", "family": "md-block", "check": "html", "input": {"md": "@(笔记本)[标签]\n"}, "expect": {"equals": ""}}
