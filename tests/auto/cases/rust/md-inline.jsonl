{"id":"mdinline-raw-multiple-inline-omitted","name":"连续多个行内标签逐个丢弃","family":"md-inline","check":"html","input":{"md":"<b>x</b><i>y</i>\n"},"expect":{"equals":"<p><!-- raw HTML omitted -->x<!-- raw HTML omitted --><!-- raw HTML omitted -->y<!-- raw HTML omitted --></p>\n"}}
# —— 标题 id 与 sourcepos 开关 ——
{"id":"mdinline-opt-heading-ids-on","name":"打开 heading_ids 后标题带 id 与锚点","family":"md-inline","check":"html","input":{"md":"# 标题\n","opts":{"heading_ids":true}},"expect":{"contains":["<h1 id=\"标题\">标题","<a href=\"#标题\"","aria-label=\"Link to heading '标题'\"","data-heading-content=\"标题\"","class=\"anchor\""]}}
{"id":"mdinline-opt-heading-ids-off","name":"默认标题没有 id 与锚点","family":"md-inline","check":"html","input":{"md":"# 标题\n"},"expect":{"equals":"<h1>标题</h1>\n","not_contains":["id=\"","class=\"anchor\""]}}
{"id":"mdinline-opt-heading-ids-cjk-space","name":"标题 id 把空格换成连字符","family":"md-inline","check":"html","input":{"md":"# 中文 标题\n","opts":{"heading_ids":true}},"expect":{"contains":["<h1 id=\"中文-标题\">","href=\"#中文-标题\""]}}
{"id":"mdinline-opt-heading-ids-duplicate","name":"重复标题的 id 加后缀去重","family":"md-inline","check":"html","input":{"md":"# 一\n\n# 一\n","opts":{"heading_ids":true}},"expect":{"contains":["<h1 id=\"一\">","<h1 id=\"一-1\">"]}}
{"id":"mdinline-opt-heading-ids-code","name":"含行内代码的标题 id 与文字","family":"md-inline","check":"html","input":{"md":"# 含 `code` 的标题\n","opts":{"heading_ids":true}},"expect":{"contains":["<h1 id=\"含-code-的标题\">含 <code>code</code> 的标题","data-heading-content=\"含 code 的标题\""]}}
{"id":"mdinline-opt-sourcepos-on","name":"打开 sourcepos 后段落带字节列号","family":"md-inline","check":"html","input":{"md":"中文\n","opts":{"render_sourcepos":true}},"expect":{"equals":"<p data-sourcepos=\"1:1-1:6\">中文</p>\n"}}
{"id":"mdinline-opt-sourcepos-chars","name":"sourcepos_chars 让列号按字符计","family":"md-inline","check":"html","input":{"md":"中文\n","opts":{"render_sourcepos":true,"sourcepos_chars":true}},"expect":{"equals":"<p data-sourcepos=\"1:1-1:2\">中文</p>\n"}}
{"id":"mdinline-opt-sourcepos-off","name":"默认不输出 sourcepos","family":"md-inline","check":"html","input":{"md":"中文\n"},"expect":{"equals":"<p>中文</p>\n","not_contains":["data-sourcepos"]}}
{"id":"mdinline-opt-sourcepos-inline-em","name":"行内强调元素也带 sourcepos","family":"md-inline","check":"html","input":{"md":"*x*\n","opts":{"render_sourcepos":true}},"expect":{"equals":"<p data-sourcepos=\"1:1-1:3\"><em data-sourcepos=\"1:1-1:3\">x</em></p>\n"}}
{"id":"mdinline-opt-sourcepos-hardbreak","name":"硬换行的 br 带 sourcepos","family":"md-inline","check":"html","input":{"md":"中文\n中文\n","opts":{"render_sourcepos":true}},"expect":{"contains":["<p data-sourcepos=\"1:1-2:6\">","<br data-sourcepos=\"1:7-1:7\" />"]}}
{"id":"mdinline-opt-heading-ids-no-sourcepos","name":"heading_ids 不连带 sourcepos","family":"md-inline","check":"html","input":{"md":"# 标题\n","opts":{"heading_ids":true}},"expect":{"contains":["id=\"标题\""],"not_contains":["data-sourcepos"]}}
# —— 行内语法组合 ——
{"id":"mdinline-mix-link-in-em","name":"斜体里的链接","family":"md-inline","check":"html","input":{"md":"*[t](https://example.com)*\n"},"expect":{"equals":"<p><em><a href=\"https://example.com\">t</a></em></p>\n"}}
{"id":"mdinline-mix-em-in-link","name":"链接文字里的加粗","family":"md-inline","check":"html","input":{"md":"[**粗**](https://example.com)\n"},"expect":{"equals":"<p><a href=\"https://example.com\"><strong>粗</strong></a></p>\n"}}
{"id":"mdinline-mix-code-in-em","name":"斜体里的行内代码","family":"md-inline","check":"html","input":{"md":"*a `b` c*\n"},"expect":{"equals":"<p><em>a <code>b</code> c</em></p>\n"}}
{"id":"mdinline-mix-star-in-code-in-em","name":"斜体里代码中的星号不破坏强调","family":"md-inline","check":"html","input":{"md":"*a `*` b*\n"},"expect":{"equals":"<p><em>a <code>*</code> b</em></p>\n"}}
{"id":"mdinline-mix-autolink-in-em","name":"斜体里的自动链接","family":"md-inline","check":"html","input":{"md":"*https://example.com*\n"},"expect":{"equals":"<p><em><a href=\"https://example.com\">https://example.com</a></em></p>\n"}}
{"id":"mdinline-mix-link-in-strong","name":"加粗里的链接","family":"md-inline","check":"html","input":{"md":"**加粗 [l](https://e.com)**\n"},"expect":{"equals":"<p><strong>加粗 <a href=\"https://e.com\">l</a></strong></p>\n"}}
{"id":"mdinline-mix-code-then-em","name":"代码 span 紧邻强调","family":"md-inline","check":"html","input":{"md":"`a`*b*\n"},"expect":{"equals":"<p><code>a</code><em>b</em></p>\n"}}
{"id":"mdinline-mix-blockquote-inline","name":"引用块里的行内强调","family":"md-inline","check":"html","input":{"md":"> 引用 *斜*\n"},"expect":{"equals":"<blockquote>\n<p>引用 <em>斜</em></p>\n</blockquote>\n"}}
{"id":"mdinline-mix-list-inline","name":"列表项里的行内强调","family":"md-inline","check":"html","input":{"md":"- 项 *斜*\n"},"expect":{"equals":"<ul>\n<li>项 <em>斜</em></li>\n</ul>\n"}}
