# md-inline 家族：行内语法与渲染安全 / 高亮的用例矩阵。
# 期望值 = 2026-11-08 产品当前行为（comrak 0.56）；每条都用 equals 或定向 contains/not_contains 钉住可观察差异。
# —— 强调与加粗：嵌套、边界、词内与中文旁的正反例 ——
{"id":"mdinline-em-star-basic","name":"星号斜体基本形态","family":"md-inline","check":"html","input":{"md":"这是*斜体*。\n"},"expect":{"equals":"<p>这是<em>斜体</em>。</p>\n"}}
{"id":"mdinline-em-underscore-basic","name":"下划线斜体基本形态","family":"md-inline","check":"html","input":{"md":"_斜体_\n"},"expect":{"equals":"<p><em>斜体</em></p>\n"}}
{"id":"mdinline-em-underscore-intraword-cjk","name":"中文紧邻的下划线不成立（词内）","family":"md-inline","check":"html","input":{"md":"这是_斜体_。\n"},"expect":{"equals":"<p>这是_斜体_。</p>\n"}}
{"id":"mdinline-em-underscore-intraword-ascii","name":"英文词内下划线不成立","family":"md-inline","check":"html","input":{"md":"foo_bar_baz\n"},"expect":{"equals":"<p>foo_bar_baz</p>\n"}}
{"id":"mdinline-em-star-intraword-ascii","name":"英文词内星号成立","family":"md-inline","check":"html","input":{"md":"foo*bar*baz\n"},"expect":{"equals":"<p>foo<em>bar</em>baz</p>\n"}}
{"id":"mdinline-em-star-cjk-adjacent","name":"中文紧邻星号成立","family":"md-inline","check":"html","input":{"md":"中文*斜体*中文\n"},"expect":{"equals":"<p>中文<em>斜体</em>中文</p>\n"}}
{"id":"mdinline-em-underscore-spaced-cjk","name":"空格隔开的中文下划线成立","family":"md-inline","check":"html","input":{"md":"中文 _斜体_ 中文\n"},"expect":{"equals":"<p>中文 <em>斜体</em> 中文</p>\n"}}
{"id":"mdinline-strong-star-basic","name":"双星号加粗基本形态","family":"md-inline","check":"html","input":{"md":"**加粗**\n"},"expect":{"equals":"<p><strong>加粗</strong></p>\n"}}
{"id":"mdinline-strong-underscore-basic","name":"双下划线加粗基本形态","family":"md-inline","check":"html","input":{"md":"__加粗__\n"},"expect":{"equals":"<p><strong>加粗</strong></p>\n"}}
{"id":"mdinline-strong-cjk-adjacent","name":"中文紧邻双星号加粗","family":"md-inline","check":"html","input":{"md":"中文**加粗**中文\n"},"expect":{"equals":"<p>中文<strong>加粗</strong>中文</p>\n"}}
{"id":"mdinline-strong-intraword-ascii","name":"英文词内双星号加粗","family":"md-inline","check":"html","input":{"md":"a**b**c\n"},"expect":{"equals":"<p>a<strong>b</strong>c</p>\n"}}
{"id":"mdinline-em-triple-star","name":"三星号同时斜体加粗","family":"md-inline","check":"html","input":{"md":"***x***\n"},"expect":{"equals":"<p><em><strong>x</strong></em></p>\n"}}
{"id":"mdinline-em-triple-underscore","name":"三下划线同时斜体加粗","family":"md-inline","check":"html","input":{"md":"___x___\n"},"expect":{"equals":"<p><em><strong>x</strong></em></p>\n"}}
{"id":"mdinline-strong-four-star","name":"四星号嵌套加粗","family":"md-inline","check":"html","input":{"md":"****x****\n"},"expect":{"equals":"<p><strong><strong>x</strong></strong></p>\n"}}
{"id":"mdinline-em-strong-nested","name":"斜体包加粗","family":"md-inline","check":"html","input":{"md":"*a**b**c*\n"},"expect":{"equals":"<p><em>a<strong>b</strong>c</em></p>\n"}}
{"id":"mdinline-strong-em-nested","name":"加粗包斜体","family":"md-inline","check":"html","input":{"md":"**a*b*c**\n"},"expect":{"equals":"<p><strong>a<em>b</em>c</strong></p>\n"}}
{"id":"mdinline-em-unmatched-single","name":"落单星号保持字面","family":"md-inline","check":"html","input":{"md":"a*b\n"},"expect":{"equals":"<p>a*b</p>\n"}}
{"id":"mdinline-em-unmatched-double","name":"落单双星号保持字面","family":"md-inline","check":"html","input":{"md":"a**b\n"},"expect":{"equals":"<p>a**b</p>\n"}}
{"id":"mdinline-em-unbalanced-mixed","name":"星号不配对时的嵌套结果","family":"md-inline","check":"html","input":{"md":"**a* b*\n"},"expect":{"equals":"<p><em><em>a</em> b</em></p>\n"}}
{"id":"mdinline-em-escaped-star","name":"反斜杠转义的星号不成强调","family":"md-inline","check":"html","input":{"md":"\\*x\\*\n"},"expect":{"equals":"<p>*x*</p>\n"}}
{"id":"mdinline-em-star-end-edge","name":"星号强调在词首边界","family":"md-inline","check":"html","input":{"md":"*x*后面\n"},"expect":{"equals":"<p><em>x</em>后面</p>\n"}}
{"id":"mdinline-em-underscore-close-intraword","name":"下划线在词内收尾不成立","family":"md-inline","check":"html","input":{"md":"a_b_\n"},"expect":{"equals":"<p>a_b_</p>\n"}}
{"id":"mdinline-em-underscore-open-intraword","name":"下划线在词内开头不成立","family":"md-inline","check":"html","input":{"md":"_a_b\n"},"expect":{"equals":"<p>_a_b</p>\n"}}
{"id":"mdinline-em-punct-flank","name":"连字符旁星号强调","family":"md-inline","check":"html","input":{"md":"foo-*bar*-baz\n"},"expect":{"equals":"<p>foo-<em>bar</em>-baz</p>\n"}}
{"id":"mdinline-strong-two-segments","name":"两个独立加粗段","family":"md-inline","check":"html","input":{"md":"**a** **b**\n"},"expect":{"equals":"<p><strong>a</strong> <strong>b</strong></p>\n"}}
{"id":"mdinline-em-two-segments","name":"两个独立斜体段","family":"md-inline","check":"html","input":{"md":"*a* *b*\n"},"expect":{"equals":"<p><em>a</em> <em>b</em></p>\n"}}
{"id":"mdinline-em-strong-mixed","name":"斜体与加粗混合收尾","family":"md-inline","check":"html","input":{"md":"*a**b**c*d\n"},"expect":{"equals":"<p><em>a<strong>b</strong>c</em>d</p>\n"}}
{"id":"mdinline-em-nested-em","name":"星号内嵌下划线斜体","family":"md-inline","check":"html","input":{"md":"*a _b_ c*\n"},"expect":{"equals":"<p><em>a <em>b</em> c</em></p>\n"}}
{"id":"mdinline-strong-nested-strong","name":"双星号内嵌双下划线加粗","family":"md-inline","check":"html","input":{"md":"**a __b__ c**\n"},"expect":{"equals":"<p><strong>a <strong>b</strong> c</strong></p>\n"}}
{"id":"mdinline-strong-underscore-inner","name":"加粗内部单下划线不成立","family":"md-inline","check":"html","input":{"md":"__a_b__\n"},"expect":{"equals":"<p><strong>a_b</strong></p>\n"}}
# —— 行内代码：反引号数量、内容不被二次解析、空代码 ——
{"id":"mdinline-code-basic","name":"行内代码基本形态","family":"md-inline","check":"html","input":{"md":"这是 `code` 结束\n"},"expect":{"equals":"<p>这是 <code>code</code> 结束</p>\n"}}
{"id":"mdinline-code-double-backtick-contains-tick","name":"双反引号包裹含反引号内容","family":"md-inline","check":"html","input":{"md":"``a`b``\n"},"expect":{"equals":"<p><code>a`b</code></p>\n"}}
{"id":"mdinline-code-hash-literal","name":"行内代码里的井号不被当标题","family":"md-inline","check":"html","input":{"md":"`# not heading`\n"},"expect":{"equals":"<p><code># not heading</code></p>\n"}}
{"id":"mdinline-code-dollar-not-math","name":"行内代码里的美元号不解析成公式","family":"md-inline","check":"html","input":{"md":"`$x$`\n"},"expect":{"equals":"<p><code>$x$</code></p>\n","not_contains":["<math"]}}
{"id":"mdinline-code-star-not-emphasis","name":"行内代码里的星号不二次解析","family":"md-inline","check":"html","input":{"md":"`*x*`\n"},"expect":{"equals":"<p><code>*x*</code></p>\n"}}
{"id":"mdinline-code-html-escaped","name":"行内代码里的尖括号被转义","family":"md-inline","check":"html","input":{"md":"`<script>`\n"},"expect":{"equals":"<p><code>&lt;script&gt;</code></p>\n","not_contains":["<script"]}}
{"id":"mdinline-code-amp-escaped","name":"行内代码里的与号被转义","family":"md-inline","check":"html","input":{"md":"`a & b`\n"},"expect":{"equals":"<p><code>a &amp; b</code></p>\n"}}
{"id":"mdinline-code-empty-double-tick","name":"两个反引号之间没有内容不是代码","family":"md-inline","check":"html","input":{"md":"``\n"},"expect":{"equals":"<p>``</p>\n"}}
{"id":"mdinline-code-single-space","name":"只含一个空格的代码 span 保留空格","family":"md-inline","check":"html","input":{"md":"` `\n"},"expect":{"equals":"<p><code> </code></p>\n"}}
{"id":"mdinline-code-space-padded-strip","name":"代码 span 首尾各一空格被剥掉","family":"md-inline","check":"html","input":{"md":"` a `\n"},"expect":{"equals":"<p><code>a</code></p>\n"}}
{"id":"mdinline-code-triple-run","name":"三反引号行内代码","family":"md-inline","check":"html","input":{"md":"```a```\n"},"expect":{"equals":"<p><code>a</code></p>\n"}}
{"id":"mdinline-code-multiline","name":"跨行代码 span 的换行变空格","family":"md-inline","check":"html","input":{"md":"`a\nb`\n"},"expect":{"equals":"<p><code>a b</code></p>\n"}}
{"id":"mdinline-code-double-both-sides","name":"等长双反引号代码","family":"md-inline","check":"html","input":{"md":"``a``\n"},"expect":{"equals":"<p><code>a</code></p>\n"}}
{"id":"mdinline-code-asymmetric-runs","name":"不等长反引号串的切分","family":"md-inline","check":"html","input":{"md":"`a``b`\n"},"expect":{"equals":"<p><code>a``b</code></p>\n"}}
{"id":"mdinline-code-escaped-backtick","name":"反斜杠转义的反引号不成代码","family":"md-inline","check":"html","input":{"md":"\\`x\\`\n"},"expect":{"equals":"<p>`x`</p>\n"}}
{"id":"mdinline-code-entity-literal","name":"代码 span 里的实体按字面转义","family":"md-inline","check":"html","input":{"md":"`&amp;`\n"},"expect":{"equals":"<p><code>&amp;amp;</code></p>\n"}}
# —— 链接：内联/参考式/角括号/相对路径/锚点/受控标记与危险协议 ——
{"id":"mdinline-link-inline-basic","name":"内联链接基本形态","family":"md-inline","check":"html","input":{"md":"[t](https://example.com/a?b=1)\n"},"expect":{"equals":"<p><a href=\"https://example.com/a?b=1\">t</a></p>\n"}}
{"id":"mdinline-link-title","name":"链接标题进入 title 属性","family":"md-inline","check":"html","input":{"md":"[t](https://example.com \"标题\")\n"},"expect":{"equals":"<p><a href=\"https://example.com\" title=\"标题\">t</a></p>\n"}}
{"id":"mdinline-link-reference-full","name":"参考式链接（完整形式）","family":"md-inline","check":"html","input":{"md":"[t][r]\n\n[r]: https://example.com\n"},"expect":{"equals":"<p><a href=\"https://example.com\">t</a></p>\n"}}
{"id":"mdinline-link-reference-collapsed","name":"参考式链接（折叠形式）","family":"md-inline","check":"html","input":{"md":"[r][]\n\n[r]: https://example.com\n"},"expect":{"equals":"<p><a href=\"https://example.com\">r</a></p>\n"}}
{"id":"mdinline-link-reference-shortcut","name":"参考式链接（简写形式）","family":"md-inline","check":"html","input":{"md":"[r]\n\n[r]: https://example.com\n"},"expect":{"equals":"<p><a href=\"https://example.com\">r</a></p>\n"}}
{"id":"mdinline-link-angle-dest-space","name":"尖括号目标里的空格被百分号编码","family":"md-inline","check":"html","input":{"md":"[t](<https://example.com/a b>)\n"},"expect":{"equals":"<p><a href=\"https://example.com/a%20b\">t</a></p>\n"}}
{"id":"mdinline-link-empty-target","name":"空目标链接仍写出空 href","family":"md-inline","check":"html","input":{"md":"[t]()\n"},"expect":{"equals":"<p><a href=\"\">t</a></p>\n"}}
{"id":"mdinline-link-relative-path","name":"相对路径原样进入 href","family":"md-inline","check":"html","input":{"md":"[t](docs/a.md)\n"},"expect":{"equals":"<p><a href=\"docs/a.md\">t</a></p>\n"}}
{"id":"mdinline-link-relative-fragment","name":"相对路径带锚点","family":"md-inline","check":"html","input":{"md":"[t](../a.md#sec)\n"},"expect":{"equals":"<p><a href=\"../a.md#sec\">t</a></p>\n"}}
{"id":"mdinline-link-anchor-cjk","name":"中文锚点被百分号编码","family":"md-inline","check":"html","input":{"md":"[t](#标题)\n"},"expect":{"equals":"<p><a href=\"#%E6%A0%87%E9%A2%98\">t</a></p>\n"}}
{"id":"mdinline-link-anchor-ascii","name":"ASCII 锚点原样保留","family":"md-inline","check":"html","input":{"md":"[t](#install)\n"},"expect":{"equals":"<p><a href=\"#install\">t</a></p>\n"}}
{"id":"mdinline-link-anchor-second-hash","name":"锚点里的第二个井号保留","family":"md-inline","check":"html","input":{"md":"[t](#a#b)\n"},"expect":{"equals":"<p><a href=\"#a#b\">t</a></p>\n"}}
{"id":"mdinline-link-rmd-file","name":"file: 改写成 rmd-file 标记","family":"md-inline","check":"html","input":{"md":"[t](file:///tmp/a%20b.md)\n"},"expect":{"equals":"<p><a href=\"rmd-file:/tmp/a%20b.md\">t</a></p>\n"}}
{"id":"mdinline-link-rmd-file-anchor","name":"file: 改写成 rmd-file 并保留锚点","family":"md-inline","check":"html","input":{"md":"[t](file:///tmp/a.md#sec)\n"},"expect":{"equals":"<p><a href=\"rmd-file:/tmp/a.md#sec\">t</a></p>\n"}}
{"id":"mdinline-link-file-query-unsupported","name":"带 query 的 file: 判成不支持","family":"md-inline","check":"html","input":{"md":"[t](file:///tmp/a.md?raw=1)\n"},"expect":{"equals":"<p><a href=\"rmd-unsupported:file\">t</a></p>\n"}}
{"id":"mdinline-link-javascript-unsupported","name":"javascript: 改写成不支持标记","family":"md-inline","check":"html","input":{"md":"[t](javascript:alert(1))\n"},"expect":{"equals":"<p><a href=\"rmd-unsupported:javascript\">t</a></p>\n","not_contains":["href=\"javascript:"]}}
{"id":"mdinline-link-data-unsupported","name":"data: 改写成不支持标记","family":"md-inline","check":"html","input":{"md":"[t](data:text/html;base64,AAAA)\n"},"expect":{"equals":"<p><a href=\"rmd-unsupported:data\">t</a></p>\n"}}
{"id":"mdinline-link-vbscript-unsupported","name":"vbscript: 改写成不支持标记","family":"md-inline","check":"html","input":{"md":"[t](vbscript:msgbox(1))\n"},"expect":{"equals":"<p><a href=\"rmd-unsupported:vbscript\">t</a></p>\n"}}
{"id":"mdinline-link-javascript-case-insensitive","name":"大写协议名同样判成不支持","family":"md-inline","check":"html","input":{"md":"[t](JavaScript:alert(1))\n"},"expect":{"equals":"<p><a href=\"rmd-unsupported:javascript\">t</a></p>\n"}}
{"id":"mdinline-link-mailto-passthrough","name":"mailto 链接原样输出","family":"md-inline","check":"html","input":{"md":"[t](mailto:a@b.com)\n"},"expect":{"equals":"<p><a href=\"mailto:a@b.com\">t</a></p>\n"}}
{"id":"mdinline-link-ftp-passthrough","name":"ftp 链接原样输出（非 http 但不危险）","family":"md-inline","check":"html","input":{"md":"[t](ftp://example.com/x)\n"},"expect":{"equals":"<p><a href=\"ftp://example.com/x\">t</a></p>\n"}}
{"id":"mdinline-link-empty-text","name":"空链接文字仍渲染 a 元素","family":"md-inline","check":"html","input":{"md":"[](https://example.com)\n"},"expect":{"equals":"<p><a href=\"https://example.com\"></a></p>\n"}}
{"id":"mdinline-link-text-entity","name":"链接文字里的实体被转义","family":"md-inline","check":"html","input":{"md":"[a&amp;b](https://example.com)\n"},"expect":{"equals":"<p><a href=\"https://example.com\">a&amp;b</a></p>\n"}}
{"id":"mdinline-link-text-emphasis","name":"链接文字允许行内强调","family":"md-inline","check":"html","input":{"md":"[*x*](https://example.com)\n"},"expect":{"equals":"<p><a href=\"https://example.com\"><em>x</em></a></p>\n"}}
{"id":"mdinline-link-dest-nested-paren","name":"目标里的成对圆括号不截断链接","family":"md-inline","check":"html","input":{"md":"[t](https://example.com/a(b))\n"},"expect":{"equals":"<p><a href=\"https://example.com/a(b)\">t</a></p>\n"}}
{"id":"mdinline-link-dest-bare-space-invalid","name":"裸空格目标不成立，URL 退化成自动链接","family":"md-inline","check":"html","input":{"md":"[t](https://example.com/a b)\n"},"expect":{"equals":"<p>[t](<a href=\"https://example.com/a\">https://example.com/a</a> b)</p>\n"}}
{"id":"mdinline-link-dest-escaped-space-invalid","name":"转义空格目标也不成立","family":"md-inline","check":"html","input":{"md":"[t](a\\ b)\n"},"expect":{"equals":"<p>[t](a\\ b)</p>\n"}}
{"id":"mdinline-link-relative-query-kept","name":"相对路径带 query 仍原样进 href","family":"md-inline","check":"html","input":{"md":"[t](a.md?raw=1)\n"},"expect":{"equals":"<p><a href=\"a.md?raw=1\">t</a></p>\n"}}
{"id":"mdinline-link-dest-entity","name":"目标里的实体解码后再转义","family":"md-inline","check":"html","input":{"md":"[t](a&amp;b)\n"},"expect":{"equals":"<p><a href=\"a&amp;b\">t</a></p>\n"}}
# —— 图片：alt、标题、危险协议与数据 URI ——
{"id":"mdinline-img-basic","name":"图片基本形态","family":"md-inline","check":"html","input":{"md":"![alt](a.png)\n"},"expect":{"equals":"<p><img src=\"a.png\" alt=\"alt\" /></p>\n"}}
{"id":"mdinline-img-title","name":"图片标题进入 title 属性","family":"md-inline","check":"html","input":{"md":"![alt](a.png \"标题\")\n"},"expect":{"equals":"<p><img src=\"a.png\" alt=\"alt\" title=\"标题\" /></p>\n"}}
{"id":"mdinline-img-empty-alt","name":"空 alt 图片","family":"md-inline","check":"html","input":{"md":"![](a.png)\n"},"expect":{"equals":"<p><img src=\"a.png\" alt=\"\" /></p>\n"}}
{"id":"mdinline-img-data-unsupported","name":"data: 图片改写成不支持标记","family":"md-inline","check":"html","input":{"md":"![a](data:image/png;base64,AAAA)\n"},"expect":{"equals":"<p><img src=\"rmd-unsupported:data\" alt=\"a\" /></p>\n"}}
{"id":"mdinline-img-rmd-file","name":"file: 图片改写成 rmd-file 标记","family":"md-inline","check":"html","input":{"md":"![图](file:///tmp/%E4%B8%AD.png)\n"},"expect":{"equals":"<p><img src=\"rmd-file:/tmp/%E4%B8%AD.png\" alt=\"图\" /></p>\n"}}
{"id":"mdinline-img-javascript-unsupported","name":"javascript: 图片改写成不支持标记","family":"md-inline","check":"html","input":{"md":"![a](javascript:alert(1))\n"},"expect":{"equals":"<p><img src=\"rmd-unsupported:javascript\" alt=\"a\" /></p>\n"}}
{"id":"mdinline-img-alt-emphasis-stripped","name":"alt 文本里的强调标记被剥掉","family":"md-inline","check":"html","input":{"md":"![*x*](a.png)\n"},"expect":{"equals":"<p><img src=\"a.png\" alt=\"x\" /></p>\n"}}
{"id":"mdinline-img-relative","name":"图片相对路径原样输出","family":"md-inline","check":"html","input":{"md":"![a](../assets/p.png)\n"},"expect":{"equals":"<p><img src=\"../assets/p.png\" alt=\"a\" /></p>\n"}}
{"id":"mdinline-img-query-kept","name":"图片相对路径带 query 原样输出","family":"md-inline","check":"html","input":{"md":"![a](a.png?x=1)\n"},"expect":{"equals":"<p><img src=\"a.png?x=1\" alt=\"a\" /></p>\n"}}
{"id":"mdinline-img-angle-dest-space","name":"图片尖括号目标里的空格被编码","family":"md-inline","check":"html","input":{"md":"![alt](<a b.png>)\n"},"expect":{"equals":"<p><img src=\"a%20b.png\" alt=\"alt\" /></p>\n"}}
# —— GFM 自动链接：URL、邮箱、末尾标点 ——
{"id":"mdinline-autolink-url","name":"裸 URL 自动链接","family":"md-inline","check":"html","input":{"md":"https://example.com\n"},"expect":{"equals":"<p><a href=\"https://example.com\">https://example.com</a></p>\n"}}
{"id":"mdinline-autolink-trailing-dot","name":"URL 末尾句点不算进链接","family":"md-inline","check":"html","input":{"md":"见 https://example.com.\n"},"expect":{"equals":"<p>见 <a href=\"https://example.com\">https://example.com</a>.</p>\n"}}
{"id":"mdinline-autolink-trailing-question","name":"URL 末尾问号被剥掉","family":"md-inline","check":"html","input":{"md":"见 https://example.com? 下一步\n"},"expect":{"equals":"<p>见 <a href=\"https://example.com\">https://example.com</a>? 下一步</p>\n"}}
{"id":"mdinline-autolink-parens","name":"圆括号包裹的 URL","family":"md-inline","check":"html","input":{"md":"(https://example.com)\n"},"expect":{"equals":"<p>(<a href=\"https://example.com\">https://example.com</a>)</p>\n"}}
{"id":"mdinline-autolink-email","name":"裸邮箱自动链接成 mailto","family":"md-inline","check":"html","input":{"md":"联系 a.b+c@example.com 谢谢\n"},"expect":{"equals":"<p>联系 <a href=\"mailto:a.b+c@example.com\">a.b+c@example.com</a> 谢谢</p>\n"}}
{"id":"mdinline-autolink-www","name":"www 前缀自动补 http 协议","family":"md-inline","check":"html","input":{"md":"www.example.com\n"},"expect":{"equals":"<p><a href=\"http://www.example.com\">www.example.com</a></p>\n"}}
{"id":"mdinline-autolink-angle-url","name":"尖括号 URL 自动链接","family":"md-inline","check":"html","input":{"md":"<https://example.com/x>\n"},"expect":{"equals":"<p><a href=\"https://example.com/x\">https://example.com/x</a></p>\n"}}
{"id":"mdinline-autolink-angle-email","name":"尖括号邮箱自动链接","family":"md-inline","check":"html","input":{"md":"<a@b.com>\n"},"expect":{"equals":"<p><a href=\"mailto:a@b.com\">a@b.com</a></p>\n"}}
