{
  "schema": "rmd-gui-manifest/1",
  "_说明": [
    "design/0064 P1：GUI 层的驱动清单。执行器（tests/auto/runner.py::run_gui_case）只读这里，",
    "不复制任何判据。「exit」是驱动自己的退出码 → 结论映射；未登记的码一律记 harness 错。",
    "「wired=false」= P1 暂不接入，⛔ 不是通过。",
    "「est_s」为 null = 尚未实测（design/0064 §7.3 要求首次跑过后补数）。"
  ],
  "drivers": {
    "i18n": {
      "form": "offscreen",
      "script": "tools/wkwebview-probe/i18n-probe.sh",
      "target": "probe-i18n",
      "exit": {
        "0": "pass",
        "1": "fail",
        "2": "skip",
        "3": "harness",
        "4": "fail"
      },
      "json": true,
      "est_s": 3.3,
      "wired": true,
      "notes": "0/1/2/3/4 = 通过/失败/跳过/跑不起来/变异没落盘"
    },
    "doclist": {
      "form": "offscreen",
      "script": "tools/wkwebview-probe/doclist-probe.sh",
      "target": "probe-doclist",
      "exit": {
        "0": "pass",
        "1": "fail",
        "3": "harness"
      },
      "json": true,
      "est_s": 4.4,
      "wired": true,
      "notes": "无 2：判据 A–E 全有结论，跳过不是允许态"
    },
    "sidebar-search": {
      "form": "offscreen",
      "script": "tools/wkwebview-probe/sidebar-search-probe.sh",
      "target": "probe-sidebar-search",
      "exit": {
        "0": "pass",
        "1": "fail",
        "3": "harness"
      },
      "json": true,
      "est_s": 1.9,
      "wired": true,
      "notes": "判据 A–I ＋ E 自证"
    },
    "link-nav": {
      "form": "offscreen",
